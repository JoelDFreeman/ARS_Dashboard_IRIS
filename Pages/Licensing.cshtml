@page
@model ActiveRolesDashboard.Pages.LicensingModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Licensing & Compliance";
    Layout = null;

    // Precompute licensing threshold data so the @if blocks below contain only markup
    // (declaring locals/lambdas directly inside an @if{} body can suppress following markup).
    var licHasData = Model.HasLicensingThresholds
        && Model.Summary.ManagedObjects.Error == null
        && Model.Summary.ManagedObjects.DataPoints.Any();
    var licShowPanel = licHasData && Model.KpiSettings.IsKpiEnabled("Licensing", "ManagedObjects");

    var licOverThreshold = false;
    object[] licCategories = System.Array.Empty<object>();
    if (licHasData)
    {
        var licRun = Model.Summary.ManagedObjects.DataPoints.Last();
        System.Func<string, int> licTotal = cat => licRun.Items
            .Where(i => string.Equals(i.Category, cat, StringComparison.OrdinalIgnoreCase))
            .Sum(i => i.Count);
        var licDomain = licTotal("Domain");
        var licPartition = licTotal("Partition");
        var licAzure = licTotal("Azure");
        var licSaas = licTotal("SAAS");
        var licGrand = licRun.Items.Sum(i => i.Count);

        licOverThreshold =
            (Model.LicensedDomainObjects > 0 && licDomain > Model.LicensedDomainObjects)
            || (Model.LicensedPartitionObjects > 0 && licPartition > Model.LicensedPartitionObjects)
            || (Model.LicensedAzureObjects > 0 && licAzure > Model.LicensedAzureObjects)
            || (Model.LicensedSaasObjects > 0 && licSaas > Model.LicensedSaasObjects)
            || (Model.LicensedTotalObjects > 0 && licGrand > Model.LicensedTotalObjects);

        licCategories = new object[]
        {
            new { key = "Domain", label = Localizer["Cat_Domain"].Value, total = licDomain, threshold = Model.LicensedDomainObjects },
            new { key = "Partition", label = Localizer["Cat_Partition"].Value, total = licPartition, threshold = Model.LicensedPartitionObjects },
            new { key = "Azure", label = Localizer["Cat_Azure"].Value, total = licAzure, threshold = Model.LicensedAzureObjects },
            new { key = "SAAS", label = Localizer["Cat_Saas"].Value, total = licSaas, threshold = Model.LicensedSaasObjects },
            new { key = "Total", label = Localizer["Cat_GrandTotal"].Value, total = licGrand, threshold = Model.LicensedTotalObjects }
        };
    }
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <base href="@Url.Content("~/")" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Active Roles Dashboard - Licensing &amp; Compliance</title>
    <link rel="stylesheet" href="css/dashboard.css" asp-append-version="true" />
</head>
<body>
<div class="loading-overlay active" id="loadingOverlay">
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p>@Localizer["LoadingDashboardData"]</p>
    </div>
</div>
<div class="page">
    <div class="sticky-head">
    @{
        ViewData["HeaderKey"] = "Licensing";
        ViewData["RefreshUrl"] = "/Licensing"; ViewData["ShowHome"] = true; ViewData["DashboardKey"] = "Licensing";
    }
    <partial name="_DashboardHeader" />

    <a href="@(HttpContext.Request.PathBase)/?cached=true" class="back-link">&larr; @Localizer["BackToDashboard"]</a>
    </div>

    @if (Model.KpiSettings.LicensingEnabled)
    {
        <details class="kpi-category iris-accordion" open>
            <summary class="iris-accordion-header kpi-category-title" aria-expanded="true"><span class="iris-accordion-caret" aria-hidden="true"></span><span>@CategoryInfo.Licensing.DisplayName</span></summary>
                <div class="iris-accordion-content">
                    <div class="iris-accordion-surface">
                <div class="kpi-grid">
            @foreach (var kpi in KpiInfo.ForCategory(CategoryInfo.Licensing))
            {
                if (!Model.KpiSettings.IsKpiEnabled(CategoryInfo.Licensing.Key, kpi.Key)) { continue; }
                var result = Model.Summary.GetKpiResult(kpi.Key);
                var hasRisk = kpi.IsRiskKpi && (result.Error != null || result.Count > 0);
            <div class="kpi @kpi.CssColor iris-kpi-row @(kpi.IsRiskKpi ? "is-risk" : "") @(hasRisk ? "has-risk" : "")" data-section="@kpi.SectionId">
                <div class="lbl">@kpi.Label</div>
                <div class="val">@(result.Error ?? result.Count.ToString())</div>
            </div>
            }
        </div>
        @await Html.PartialAsync("_CategoryCharts", (CategoryInfo.Licensing, Model.Summary, Model.KpiSettings))
                    </div>
                </div>
    </details>
    }

    <hr class="kpi-separator" />

    <!-- Drill-down panels -->
    <div class="panel-grid">
        @if (Model.KpiSettings.IsKpiEnabled("Licensing", "ManagedObjects"))
        {
        <div class="panel" id="panel-managedobjects">
            <h2><span class="sec-icon">O</span> @Localizer["H_ManagedObjects"]</h2>
            <div class="panel-content">
                @if (Model.Summary.ManagedObjects.Error != null)
                {
                    <p class="muted">@Model.Summary.ManagedObjects.Error</p>
                }
                else if (!Model.Summary.ManagedObjects.DataPoints.Any())
                {
                    <p class="muted">@Localizer["E_ManagedObjects"]</p>
                }
                else
                {
                    <div style="position:relative; height:350px;">
                        <canvas id="managedObjectsChart"></canvas>
                    </div>
                }
            </div>
        </div>
        }

        @if (licShowPanel)
        {
            <div class="panel panel-static" id="panel-licensingthresholds">
            <h2>
                <span class="sec-icon">L</span> @Localizer["H_LicensingThresholds"]
                <span style="margin-left:8px; padding:2px 8px; border-radius:9999px; background:var(--oi-background-color-error); color:var(--oi-content-color-error); border:1px solid var(--oi-border-color-badge-error); font-size:.72rem; font-weight:600; @(licOverThreshold ? "" : "display:none;")">@Localizer["Badge_OverEntitlement"]</span>
            </h2>
            <div class="panel-content">
                <div style="position:relative; height:350px;">
                    <canvas id="licensingThresholdsChart"></canvas>
                </div>
            </div>
        </div>
        }
    </div>

    <footer class="footer">Active Roles Dashboard &mdash; Generated at @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC</footer>
</div>
@await Html.PartialAsync("_EntraMembershipConfig")
@await Html.PartialAsync("_ToastAndMembership")
<script src="js/chart.umd.min.js" asp-append-version="true"></script>
<script src="js/dashboard.js" asp-append-version="true"></script>
@if (Model.Summary.ManagedObjects.DataPoints.Any())
{
<script>
(function() {
    var canvas = document.getElementById('managedObjectsChart');
    if (!canvas) return;

    var dataPoints = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Summary.ManagedObjects.DataPoints.Select(dp => new {
            runTime = dp.RunTime.ToString("yyyy-MM-dd HH:mm"),
            items = dp.Items.Select(i => new { displayName = i.DisplayName, category = i.Category, count = i.Count })
        })
    ));

    var labels = dataPoints.map(function(dp) { return dp.runTime; });
    var itemNames = [];
    var itemMap = {};
    dataPoints.forEach(function(dp) {
        dp.items.forEach(function(item) {
            var key = item.category + ': ' + item.displayName;
            if (!itemMap[key]) { itemMap[key] = true; itemNames.push(key); }
        });
    });

    var colors = ['blue', 'green', 'amber', 'red', 'purple', 'teal', 'pink', 'slate', 'orange', 'indigo']
        .map(window.irisChartTokens.color);
    var datasets = itemNames.map(function(name, idx) {
        var data = dataPoints.map(function(dp) {
            var found = dp.items.find(function(item) { return (item.category + ': ' + item.displayName) === name; });
            return found ? found.count : 0;
        });
        return { label: name, data: data, borderColor: colors[idx % colors.length], backgroundColor: colors[idx % colors.length] + '20', tension: 0.3, fill: false, pointRadius: 3 };
    });

    new Chart(canvas, {
        type: 'line',
        data: { labels: labels, datasets: datasets },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
            scales: {
                x: { title: { display: true, text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_Time"].Value)) }, ticks: { maxRotation: 45, font: { size: 10 } } },
                y: { title: { display: true, text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_ObjectCount"].Value)) }, beginAtZero: true }
            }
        }
    });
})();
</script>
}
@if (licHasData)
{
    <script>
(function() {
    var canvas = document.getElementById('licensingThresholdsChart');
    if (!canvas || typeof Chart === 'undefined') { return; }
    var cats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(licCategories));
    var labels = cats.map(function(c) { return c.label; });
    var breachColor = window.irisChartTokens.token('--oi-content-color-error');
    var entitlementColor = window.irisChartTokens.token('--oi-content-color-primary');

    // Per-category colours matching the Managed Objects chart palette;
    // Grand Total gets its own distinct colour.
    var categoryColors = {
        'Domain': window.irisChartTokens.color('blue'),
        'Partition': window.irisChartTokens.color('green'),
        'Azure': window.irisChartTokens.color('amber'),
        'SAAS': window.irisChartTokens.color('purple'),
        'Total': window.irisChartTokens.color('slate')
    };
    function colorFor(key) { return categoryColors[key] || window.irisChartTokens.color('blue'); }

    var barData = cats.map(function(c) { return c.total; });
    var barColors = cats.map(function(c) {
        return (c.threshold > 0 && c.total > c.threshold) ? breachColor : colorFor(c.key);
    });

    // Threshold overlay: an independent per-category marker (no connecting line),
    // shown only where an entitlement is configured, sitting above each bar.
    var thresholdData = cats.map(function(c) { return c.threshold > 0 ? c.threshold : null; });

    // Draws each entitlement marker as a horizontal line spanning the exact pixel
    // width of the bar beneath it, so the marker width matches the data point rather
    // than using a fixed point size that looks too narrow.
    var thresholdMarkerPlugin = {
        id: 'thresholdMarker',
        afterDatasetsDraw: function(chart) {
            var barMeta = chart.getDatasetMeta(0);
            var lineMeta = chart.getDatasetMeta(1);
            if (!barMeta || !lineMeta || lineMeta.hidden) return;
            var ctx = chart.ctx;
            ctx.save();
            ctx.strokeStyle = entitlementColor;
            ctx.lineWidth = 3;
            lineMeta.data.forEach(function(point, i) {
                if (thresholdData[i] === null || thresholdData[i] === undefined) return;
                var bar = barMeta.data[i];
                if (!bar) return;
                var halfWidth = (bar.width || 0) / 2;
                var y = point.y;
                ctx.beginPath();
                ctx.moveTo(bar.x - halfWidth, y);
                ctx.lineTo(bar.x + halfWidth, y);
                ctx.stroke();
            });
            ctx.restore();
        }
    };

    new Chart(canvas, {
        type: 'bar',
        plugins: [thresholdMarkerPlugin],
        data: {
            labels: labels,
            datasets: [
                {
                    type: 'bar',
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_Actual"].Value)),
                    data: barData,
                    backgroundColor: barColors,
                    borderColor: barColors,
                    borderWidth: 1,
                    order: 2
                },
                {
                    type: 'line',
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_Entitlement"].Value)),
                    data: thresholdData,
                    borderColor: entitlementColor,
                    backgroundColor: entitlementColor,
                    pointRadius: 0,
                    pointHoverRadius: 11,
                    pointStyle: 'line',
                    pointBorderWidth: 3,
                    showLine: false,
                    spanGaps: false,
                    order: 1
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12, font: { size: 11 }, usePointStyle: true,
                        generateLabels: function(chart) {
                            var out = cats.map(function(c) {
                                var breached = (c.threshold > 0 && c.total > c.threshold);
                                return {
                                    text: c.label,
                                    fillStyle: breached ? breachColor : colorFor(c.key),
                                    strokeStyle: breached ? breachColor : colorFor(c.key),
                                    pointStyle: 'rectRounded',
                                    hidden: false
                                };
                            });
                            out.push({
                                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_Entitlement"].Value)),
                                fillStyle: entitlementColor,
                                strokeStyle: entitlementColor,
                                pointStyle: 'line',
                                lineWidth: 3,
                                hidden: false
                            });
                            return out;
                        }
                    }
                }
            },
            scales: {
                x: { ticks: { font: { size: 11 } } },
                y: { title: { display: true, text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_ObjectCount"].Value)) }, beginAtZero: true }
            }
        }
    });
})();
</script>
}
@if (Model.AutoRefreshMinutes > 0)
{
<script>
    setTimeout(function() { document.getElementById('loadingOverlay').classList.add('active'); window.location.reload(); }, @(Model.AutoRefreshMinutes * 60 * 1000));
</script>
}
<script>
    document.getElementById('loadingOverlay').classList.remove('active');
    window.addEventListener('beforeunload', function() {
        if (window.__isExporting) return;
        document.getElementById('loadingOverlay').classList.add('active');
    });
    document.getElementById('btnRefresh').addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('loadingOverlay').classList.add('active');
        window.location.reload();
    });
    function toggleCategory(btn) {
        var category = btn.closest('.kpi-category');
        category.classList.toggle('collapsed');
        btn.classList.toggle('collapsed');
        btn.title = category.classList.contains('collapsed') ? 'Expand' : 'Collapse';
    }

    // Licensing has a single KPI (Managed Objects); select it by default so its
    // drill-down chart is shown alongside the entitlements chart on load.
    (function selectDefaultLicensingKpi() {
        if (window.location.hash && window.location.hash.indexOf('#panel-') === 0) return;
        if (typeof openDashboardSection === 'function') {
            openDashboardSection('managedobjects', false);
        }
    })();
</script>
</body>
</html>
