@* Left navigation sidebar (Iris shell pattern), replacing the old icon-only vertical rail.
   Parameters (via ViewData) — same flags _DashboardToolbar already reads:
     - "ShowAdminRebuild" / "CacheRebuildInProgress"
     - "ShowAssessments", "ShowAttackExposure", "ShowSnapshots", "ShowSettings"
*@
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var appBase = Context.Request.PathBase.Value ?? "";
    var currentPath = Context.Request.Path.Value ?? "";
    var showAdminRebuild = ViewData["ShowAdminRebuild"] as bool? ?? false;
    var cacheRebuildInProgress = ViewData["CacheRebuildInProgress"] as bool? ?? false;
    var showSettings = ViewData["ShowSettings"] as bool? ?? true;
    var showSnapshots = ViewData["ShowSnapshots"] as bool? ?? true;
    var showAttackExposure = ViewData["ShowAttackExposure"] as bool? ?? true;
    var showAssessments = ViewData["ShowAssessments"] as bool? ?? true;
    bool IsActive(string path) => currentPath.Equals(path, StringComparison.OrdinalIgnoreCase);
}
<aside class="sidebar" aria-label="Main navigation">
    <div class="sidebar-header">
        <span class="sidebar-logo"><img src="images/iris-brand-logo.svg" alt="" /></span>
        <span class="sidebar-title">Active Roles KPI Dashboard</span>
    </div>
    <nav class="sidebar-nav-group">
        <a href="@(appBase)/?cached=true" class="sidebar-nav-item" aria-current="@(IsActive("/") ? "page" : null)">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>@Localizer["Home"]</span>
        </a>
        @if (showAssessments)
        {
            <a href="@(appBase)/Assessments" class="sidebar-nav-item" aria-current="@(IsActive("/Assessments") ? "page" : null)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                <span>@Localizer["Assessment"]</span>
            </a>
        }
        @if (showAttackExposure)
        {
            <a href="@(appBase)/AttackExposure" class="sidebar-nav-item" aria-current="@(IsActive("/AttackExposure") ? "page" : null)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                <span>@Localizer["AttackExposure"]</span>
            </a>
        }
        @if (showSnapshots)
        {
            <a href="@(appBase)/Snapshots" class="sidebar-nav-item" aria-current="@(IsActive("/Snapshots") ? "page" : null)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                <span>@Localizer["Snapshots"]</span>
            </a>
        }
    </nav>
    <div class="sidebar-nav-group">
        <div class="sidebar-nav-group-header">@Localizer["ViewSettings"]</div>
        <a href="@(appBase)/?cached=true" class="sidebar-nav-item" id="btnRefresh">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            <span>@Localizer["Refresh"]</span>
        </a>
        @if (showAdminRebuild)
        {
            <form method="post" asp-page-handler="Refresh" class="sidebar-nav-item-form" id="rebuildCacheForm">
                <button type="submit" class="sidebar-nav-item @(cacheRebuildInProgress ? "sidebar-nav-item-spinning" : "")" id="btnRebuildCache" @(cacheRebuildInProgress ? "disabled" : "") aria-disabled="@(cacheRebuildInProgress ? "true" : "false")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                    <span>@Localizer["RebuildCache"]</span>
                </button>
            </form>
            <script>
                (function () {
                    var form = document.getElementById('rebuildCacheForm');
                    var btn = document.getElementById('btnRebuildCache');
                    if (!form || !btn) return;
                    form.addEventListener('submit', function () {
                        btn.disabled = true;
                        btn.setAttribute('aria-disabled', 'true');
                        btn.classList.add('sidebar-nav-item-spinning');
                        window.cacheRebuildInFlight = true;
                        try { sessionStorage.setItem('cacheRebuildInFlight', '1'); } catch (e) { }
                        if (window.membershipBadge) window.membershipBadge.hide();
                    });
                })();
            </script>
        }
    </div>
    <div class="sidebar-nav-group">
        <div class="sidebar-nav-group-header">@Localizer["Other"]</div>
        @if (showSettings)
        {
            <a href="@(appBase)/Settings" class="sidebar-nav-item" aria-current="@(IsActive("/Settings") ? "page" : null)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1.08 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1.08z"/></svg>
                <span>@Localizer["Settings"]</span>
            </a>
        }
        @* "Help with" has no destination defined yet — placeholder per Designer's answer, not a real link. *@
        <span class="sidebar-nav-item sidebar-nav-item-disabled" aria-disabled="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>@Localizer["HelpWith"]</span>
        </span>
    </div>
</aside>
