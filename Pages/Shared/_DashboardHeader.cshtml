@*
    Shared dashboard header (rpt-header).
    Parameters (via ViewData):
      - "HeaderTitle": the <h1> title text. Defaults to "Active Roles Dashboard".
      - "HeaderSubtitle": optional sub-heading text under the title.
      - "HeaderLogo": "oneidentity" (default) renders the One Identity logo image;
                      "ar" renders the "AR" text badge.
      - "HeaderRight": chooses the right-hand content:
            "toolbar"    (default) - the shared _DashboardToolbar (reads its own
                                      "RefreshUrl"/"ShowHome"/"DashboardKey" ViewData).
            "signout"    - signed-in user name + Home and Sign Out icon buttons.
            "membership" - group-membership loading indicator only.
            "none"       - no right-hand content.
      - "SignOutText": label for the Sign Out link in the "signout" variant. Defaults to "Sign Out".
*@
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var headerKey = ViewData["HeaderKey"] as string;
    var headerTitle = headerKey != null
        ? Localizer[$"Title_{headerKey}"].Value
        : ViewData["HeaderTitle"] as string ?? "Active Roles Dashboard";
    var headerSubtitle = headerKey != null
        ? Localizer[$"Sub_{headerKey}"].Value
        : ViewData["HeaderSubtitle"] as string;
    var headerRight = ViewData["HeaderRight"] as string ?? "toolbar";
    var signOutText = ViewData["SignOutText"] as string ?? Localizer["SignOut"].Value;
    var homeText = Localizer["Home"].Value;
    var membershipText = Localizer["LoadingMembership"].Value;
    var appBase = Context.Request.PathBase.Value ?? "";
    var currentPath = Context.Request.Path.Value ?? "";
    var showActiveRolesNav = ViewData["ShowActiveRolesNav"] as bool? ?? false;
    var showActiveDirectoryNav = ViewData["ShowActiveDirectoryNav"] as bool? ?? false;
    var showEntraNav = ViewData["ShowEntraNav"] as bool? ?? false;
    var showExchangeNav = ViewData["ShowExchangeNav"] as bool? ?? false;
    var showLicensingNav = ViewData["ShowLicensingNav"] as bool? ?? false;
}
@if (headerRight != "none")
{
    <partial name="_Sidebar" />
}
<header class="rpt-header">
    <div class="hdr-left">
        <span class="hdr-logo">
            <img src="images/one-identity-mark.svg" alt="One Identity" />
        </span>
        <h1>@headerTitle</h1>
    </div>
    @if (headerRight == "toolbar")
    {
        <div class="hdr-right">
            @await Html.PartialAsync("_DashboardToolbar")
        </div>
    }
    else if (headerRight == "signout")
    {
        <div class="hdr-right">
            <span class="hdr-user">@User.Identity?.Name</span>
            <a href="@(appBase)/?cached=true" class="btn-icon" title="@homeText">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </a>
            <a href="@(appBase)/Logout" class="btn-icon" title="@signOutText">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </a>
        </div>
    }
    else if (headerRight == "membership")
    {
        <div class="hdr-right">
            @* Group-membership loading indicator: people icon with a remaining-count badge.
               Hidden while idle; driven by window.membershipBadge (see _ToastAndMembership partial). *@
            <span id="membership-indicator" class="btn-icon membership-indicator" hidden style="display:none" title="@membershipText" aria-live="polite">
                <svg class="membership-indicator-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span class="membership-indicator-badge" id="membership-indicator-badge">0</span>
            </span>
        </div>
    }
</header>
@if (headerRight == "toolbar")
{
    <nav class="dashboard-nav" aria-label="Dashboard navigation">
        <a class="@(currentPath == "/" ? "active" : "")" href="@(appBase)/">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>Overview</span>
        </a>
        @if (showActiveRolesNav) { <a class="@(currentPath.StartsWith("/ActiveRoles", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="@(appBase)/ActiveRoles">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span>Active Roles</span>
        </a> }
        @if (showActiveDirectoryNav) { <a class="@(currentPath.StartsWith("/ActiveDirectory", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="@(appBase)/ActiveDirectory">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
            <span>Active Directory</span>
        </a> }
        @if (showEntraNav) { <a class="@(currentPath.StartsWith("/EntraId", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="@(appBase)/EntraId">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h.79a4.5 4.5 0 1 1 0 9z"/></svg>
            <span>Entra ID</span>
        </a> }
        @if (showExchangeNav) { <a class="@(currentPath.StartsWith("/Exchange", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="@(appBase)/Exchange">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="m22 6-10 7L2 6"/></svg>
            <span>Exchange</span>
        </a> }
        @if (showLicensingNav) { <a class="@(currentPath.StartsWith("/Licensing", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="@(appBase)/Licensing">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/></svg>
            <span>Licensing</span>
        </a> }
    </nav>
}
