@using System.Text.Json
@using ActiveRolesDashboard.Models
@model (CategoryInfo Category, DashboardSummary Summary, KpiSettings Settings)
@{
    var charts = ChartInfo.ForCategory(Model.Category);
    // The Overview category renders as a static ring + legend (per the Figma KPI Dashboard
    // design) instead of an interactive Chart.js canvas, so it never needs the donut/column
    // toggle toolbar.
    var isOverview = Model.Category.Key == "Overview";
    var showToggle = charts.Any(c => !c.DisableTypeToggle) && !isOverview;
    // Matches the exact Figma ring colours (blue-400 / green-300) for the two-source AD/Entra
    // split used by every Overview chart; any additional source falls back to the shared
    // categorical chart palette.
    string RingColor(string name) => name switch
    {
        "blue" => "var(--chart-ring-blue-400)",
        "teal" => "var(--chart-ring-green-300)",
        _ => $"var(--chart-color-{name})"
    };
}
@if (charts.Count > 0)
{
    <div class="category-charts-wrap">
        <div class="category-charts-toolbar">
            @if (showToggle)
            {
            <button type="button" class="btn-chart-toggle" onclick="toggleCategoryChartType(this)"
                    data-mode="original" title="Switch to 3-D column charts" aria-label="Switch to 3-D column charts">
                <svg class="chart-toggle-icon icon-bar" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <rect x="3" y="12" width="4" height="8" rx="1" fill="currentColor"></rect>
                    <rect x="10" y="7" width="4" height="13" rx="1" fill="currentColor"></rect>
                    <rect x="17" y="3" width="4" height="17" rx="1" fill="currentColor"></rect>
                </svg>
                <svg class="chart-toggle-icon icon-pie" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M12 3a9 9 0 1 0 9 9h-9V3z" fill="currentColor"></path>
                    <path d="M13 2a9 9 0 0 1 8 8h-8V2z" fill="currentColor" opacity=".55"></path>
                </svg>
            </button>
            }
        </div>
    <div class="category-charts">
        @foreach (var chart in charts)
        {
            var labels = new List<string>();
            var values = new List<int>();
            var colors = new List<string>();

            if (!string.IsNullOrEmpty(chart.SourceSplitKpiKey))
            {
                // Source-split chart: split an Overview total by data source (AD vs Entra ID).
                var kpi = KpiInfo.All.FirstOrDefault(k => k.Key == chart.SourceSplitKpiKey);
                if (kpi is null || !Model.Settings.IsKpiEnabled(kpi.CategoryKey, kpi.Key)) { continue; }

                var colorIndex = 0;
                foreach (var part in Model.Summary.GetSourceSplit(chart.SourceSplitKpiKey))
                {
                    if (part.Count > 0)
                    {
                        labels.Add(part.Source);
                        values.Add(part.Count);
                        // Keep the established AD (first colour) / Entra ID (second colour)
                        // mapping for the combined and AD single-source charts; for any other
                        // source (e.g. per-tenant Entra slices) cycle the palette by position.
                        string sourceColor;
                        if (part.Source == "Active Directory")
                            sourceColor = ChartInfo.SourceSplitColors[0];
                        else if (part.Source == "Entra ID")
                            sourceColor = ChartInfo.SourceSplitColors[1 % ChartInfo.SourceSplitColors.Count];
                        else
                            sourceColor = ChartInfo.SourceSplitColors[colorIndex % ChartInfo.SourceSplitColors.Count];
                        colors.Add(sourceColor);
                        colorIndex++;
                    }
                }
            }
            else
            {
                // KPI-series chart: one slice per referenced KPI; skip zero/error/disabled.
                foreach (var item in chart.Series)
                {
                    var kpi = KpiInfo.All.FirstOrDefault(k => k.Key == item.KpiKey);
                    if (kpi is null) { continue; }
                    if (!Model.Settings.IsKpiEnabled(kpi.CategoryKey, kpi.Key)) { continue; }

                    var result = Model.Summary.GetKpiResult(kpi.Key);
                    if (result.Error is not null || result.Count <= 0) { continue; }

                    labels.Add(string.IsNullOrEmpty(item.Label) ? kpi.Label : item.Label);
                    values.Add(result.Count);
                    colors.Add(string.IsNullOrEmpty(item.CssColor) ? kpi.CssColor : item.CssColor);
                }
            }

            if (values.Count == 0) { continue; }

            var chartTypeName = chart.Type.ToString().ToLowerInvariant();
            <div class="category-chart">
                <h3 class="category-chart-title">@chart.Title</h3>
                @if (isOverview)
                {
                    var total = values.Sum();
                    var pcts = values.Select(v => total > 0 ? (int)Math.Round(v * 100.0 / total) : 0).ToList();
                    const double radius = 48;
                    const double circumference = 2 * Math.PI * radius;
                    var cursor = 0.0;
                    <div class="chart-ring-row">
                        <svg class="chart-ring" viewBox="0 0 120 120" width="120" height="120" role="img" aria-label="@chart.Title">
                            <g transform="rotate(-90 60 60)">
                                @for (var i = 0; i < values.Count; i++)
                                {
                                    var slice = total > 0 ? values[i] * circumference / total : 0;
                                    var dashArray = $"{slice.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)} {circumference.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}";
                                    var dashOffset = (-cursor).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
                                    <circle cx="60" cy="60" r="@radius" fill="none" stroke="@RingColor(colors[i])" stroke-width="24" stroke-dasharray="@dashArray" stroke-dashoffset="@dashOffset" />
                                    cursor += slice;
                                }
                            </g>
                        </svg>
                        <ul class="chart-ring-legend">
                            @for (var i = 0; i < labels.Count; i++)
                            {
                                <li><span class="chart-ring-swatch" style="background: @RingColor(colors[i]);"></span>@labels[i] (@pcts[i]%)</li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <canvas class="dashboard-chart"
                        data-chart-type="@chartTypeName"
                        data-chart-notoggle="@(chart.DisableTypeToggle ? "true" : "false")"
                        data-chart-offset="@chart.SliceOffset"
                        data-chart-labels="@JsonSerializer.Serialize(labels)"
                        data-chart-values="@JsonSerializer.Serialize(values)"
                        data-chart-colors="@JsonSerializer.Serialize(colors)"></canvas>
                }
            </div>
        }
    </div>
    </div>
}
