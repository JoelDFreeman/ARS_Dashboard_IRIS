@page
@model ActiveRolesDashboard.Pages.SetupModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Setup";
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Active Roles Dashboard - Setup</title>
    <link rel="stylesheet" href="css/dashboard.css" asp-append-version="true" />
    <style>
        .setup-container { max-width: 640px; margin: 40px auto; padding: 0 20px; }
        .setup-card { background: var(--oi-background-color-primary); border: 1px solid var(--oi-border-color-muted); border-radius: var(--oi-border-radius-l); padding: 32px; box-shadow: var(--oi-shadow-low); margin-bottom: 24px; }
        .setup-card h2 { font-size: 1.05rem; font-weight: 600; color: var(--oi-content-color-primary); margin-bottom: 16px; }
        .setup-card p.subtitle { font-size: .85rem; color: var(--oi-content-color-tertiary); margin-bottom: 24px; }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: .82rem; font-weight: 600; color: var(--oi-content-color-secondary); margin-bottom: 6px; }
        .form-group input[type="text"] { width: 100%; padding: 10px 14px; border: 1px solid var(--oi-border-color-default); border-radius: 8px; font-size: .9rem; outline: none; transition: border-color .2s; box-sizing: border-box; }
        .form-group input[type="text"]:focus { border-color: var(--oi-border-color-focus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--oi-base-color-brand) 10%, transparent); }
        .form-group input[type="password"] { width: 100%; padding: 10px 14px; border: 1px solid var(--oi-border-color-default); border-radius: 8px; font-size: .9rem; outline: none; transition: border-color .2s; box-sizing: border-box; }
        .form-group input[type="password"]:focus { border-color: var(--oi-border-color-focus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--oi-base-color-brand) 10%, transparent); }
        .form-group .hint { font-size: .75rem; color: var(--oi-content-color-tertiary); margin-top: 4px; }
        .required { color: var(--oi-content-color-error); }
        .error-msg { margin-bottom: 16px; padding: 10px 14px; background: var(--oi-background-color-error); border: 1px solid var(--oi-border-color-badge-error); border-radius: 8px; font-size: .82rem; color: var(--oi-content-color-error); }
        .wizard-page { display: none; }
        .wizard-page.active { display: block; }
        .wizard-steps { display: flex; justify-content: center; gap: 8px; margin-bottom: 28px; }
        .wizard-steps .step { width: 10px; height: 10px; border-radius: 50%; background: var(--oi-border-color-default); transition: background .2s; }
        .wizard-steps .step.active { background: var(--oi-base-color-brand); }
        .wizard-steps .step.completed { background: var(--oi-base-color-success); }
        .wizard-nav { display: flex; gap: 12px; margin-top: 8px; }
        .wizard-nav button { flex: 1; padding: 12px; border: none; border-radius: 8px; font-size: .9rem; font-weight: 600; cursor: pointer; transition: background .2s; }
        .btn-back { background: var(--oi-background-color-tertiary); color: var(--oi-content-color-secondary); }
        .btn-back:hover { background: var(--oi-border-color-default); }
        .btn-next { background: var(--oi-button-background-primary); color: var(--oi-content-color-constant); }
        .btn-next:hover { background: var(--oi-button-background-primary-hover); }
        .btn-finish { background: var(--oi-base-color-success); color: var(--oi-content-color-constant); }
        .btn-finish:hover { background: var(--oi-content-color-success); }
        .lang-select-wrap { display: flex; align-items: center; gap: 10px; }
        .lang-flag { width: 24px; height: 16px; border-radius: 2px; object-fit: cover; box-shadow: var(--oi-shadow-low); flex-shrink: 0; }
        .lang-select { flex: 1; padding: 10px 14px; border: 1px solid var(--oi-border-color-default); border-radius: 8px; font-size: .9rem; outline: none; background: var(--oi-background-color-primary); }
        .lang-select:focus { border-color: var(--oi-border-color-focus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--oi-base-color-brand) 10%, transparent); }
    </style>
</head>
<body>
<div class="page">
    @{
        ViewData["HeaderKey"] = "Setup";
        ViewData["HeaderLogo"] = "ar";
        ViewData["HeaderRight"] = "none";
    }
    <partial name="_DashboardHeader" />

    <div class="setup-container">
        <div class="wizard-steps">
            <div class="step active" data-step="0"></div>
            <div class="step" data-step="1"></div>
            <div class="step" data-step="2"></div>
            <div class="step" data-step="3"></div>
            <div class="step" data-step="4"></div>
            <div class="step" data-step="5"></div>
        </div>

        <div id="wizardError" class="error-msg" style="display:none;"></div>

        @if (Model.ErrorMessage != null)
        {
            <div class="error-msg">@Model.ErrorMessage</div>
        }

        <form method="post" id="setupForm">
            <!-- Page 1: REST API Configuration -->
            <div class="wizard-page active" data-page="0">
                <div class="setup-card">
                    <h2>@Localizer["RestApiConfig"] <span class="required">*</span></h2>
                    <p class="subtitle">@Localizer["RestApiSubtitle"]</p>
                    <div class="form-group">
                        <label for="ApiBaseUrl">@Localizer["RestApiUrl"] <span class="required">*</span></label>
                        <input type="text" id="ApiBaseUrl" name="ApiBaseUrl" value="@Model.ApiBaseUrl" placeholder="https://server:5000/api/v1" />
                        <p class="hint">@Localizer["RestApiUrlHint"]</p>
                    </div>
                    <div class="form-group">
                        <label for="RstsUrl">@Localizer["RstsUrl"] <span class="required">*</span></label>
                        <input type="text" id="RstsUrl" name="RstsUrl" value="@Model.RstsUrl" placeholder="https://server:443/rsts/oauth2/token" />
                        <p class="hint">@Localizer["RstsUrlHint"]</p>
                    </div>
                    <div class="form-group">
                        <label for="RstsScope">@Localizer["RstsScope"]</label>
                        <input type="text" id="RstsScope" name="RstsScope" value="@Model.RstsScope" placeholder="rsts:sts:primaryproviderid:ad" />
                        <p class="hint">@Localizer["RstsScopeHint"]</p>
                    </div>
                    <div class="form-group demo-mode-option">
                        <label><input type="checkbox" id="DemoMode" name="DemoMode" value="true" @(Model.DemoMode ? "checked" : "") /> Use demo data and skip Active Roles connection setup</label>
                    </div>
                </div>
                <div class="wizard-nav">
                    <button type="button" class="btn-next" onclick="wizardNext()">@Localizer["Next"]</button>
                </div>
            </div>

            <!-- Page 2: Service Account Credentials -->
            <div class="wizard-page" data-page="1">
                <div class="setup-card">
                    <h2>@Localizer["ServiceAccountConfig"] <span class="required">*</span></h2>
                    <p class="subtitle">@Localizer["ServiceAccountSubtitle"]</p>
                    <div class="form-group">
                        <label for="ServiceAccountUsername">@Localizer["ServiceAccountUsername"] <span class="required">*</span></label>
                        <input type="text" id="ServiceAccountUsername" name="ServiceAccountUsername" value="@Model.ServiceAccountUsername" placeholder="DOMAIN\svc_ars" autocomplete="off" />
                        <p class="hint">@Localizer["ServiceAccountUsernameHint"]</p>
                    </div>
                    <div class="form-group">
                        <label for="ServiceAccountPassword">@Localizer["ServiceAccountPassword"] <span class="required">*</span></label>
                        <input type="password" id="ServiceAccountPassword" name="ServiceAccountPassword" value="@Model.ServiceAccountPassword" autocomplete="new-password" />
                        <p class="hint">@Localizer["ServiceAccountPasswordHint"]</p>
                    </div>
                </div>
                <div class="wizard-nav">
                    <button type="button" class="btn-back" onclick="wizardBack()">@Localizer["Back"]</button>
                    <button type="button" class="btn-next" onclick="wizardNext()">@Localizer["Next"]</button>
                </div>
            </div>

            <!-- Page 3: Web Interface -->
            <div class="wizard-page" data-page="2">
                <div class="setup-card">
                    <h2>@Localizer["WebInterface"]</h2>
                    <p class="subtitle">@Localizer["WebInterfaceSubtitle"]</p>
                    <div class="form-group">
                        <label for="WebInterfaceUrl">@Localizer["WebInterfaceUrl"]</label>
                        <input type="text" id="WebInterfaceUrl" name="WebInterfaceUrl" value="@Model.WebInterfaceUrl" placeholder="https://server/ARWebAdmin" />
                        <p class="hint">@Localizer["WebInterfaceUrlHint"]</p>
                    </div>
                </div>
                <div class="wizard-nav">
                    <button type="button" class="btn-back" onclick="wizardBack()">@Localizer["Back"]</button>
                    <button type="button" class="btn-next" onclick="wizardNext()">@Localizer["Next"]</button>
                </div>
            </div>

            <!-- Page 4: Language -->
            <div class="wizard-page" data-page="3">
                <div class="setup-card">
                    <h2>@Localizer["Language"]</h2>
                    <p class="subtitle">@Localizer["LanguageSubtitle"]</p>
                    <div class="form-group">
                        <label for="Language">@Localizer["DisplayLanguage"]</label>
                        <div class="lang-select-wrap">
                            <img id="langFlag" class="lang-flag" src="@(HttpContext.Request.PathBase)/@(Model.SelectedLanguage.FlagImage)" alt="@Model.SelectedLanguage.DisplayName flag" />
                            <select id="Language" name="Language" class="lang-select" onchange="updateLangFlag(this)">
                                @foreach (var lang in Model.Languages)
                                {
                                    <option value="@lang.Code" data-flag="@(HttpContext.Request.PathBase)/@(lang.FlagImage)" selected="@(lang.Code == Model.Language)">@lang.DisplayName</option>
                                }
                            </select>
                        </div>
                        <p class="hint">@Localizer["LanguageHint"]</p>
                    </div>
                </div>
                <div class="wizard-nav">
                    <button type="button" class="btn-back" onclick="wizardBack()">@Localizer["Back"]</button>
                    <button type="button" class="btn-next" onclick="wizardNext()">@Localizer["Next"]</button>
                </div>
            </div>

            <!-- Page 5: KPI Configuration -->
            <div class="wizard-page" data-page="4">
                <div class="setup-card">
                    <h2>@Localizer["RoleMappingConfig"]</h2>
                    <p class="subtitle">@Localizer["RoleMappingSubtitle"]</p>
                    <div class="form-group">
                        <label for="DashboardAdminsFilter">@Localizer["Lbl_DashboardAdminsFilter"]</label>
                        <input type="text" id="DashboardAdminsFilter" name="DashboardAdminsFilter" value="@Model.DashboardAdminsFilter" placeholder="@Model.Defaults.DefaultFilters.DashboardAdmins" />
                        <p class="hint">@Localizer["Hint_DashboardAdminsFilter"]</p>
                    </div>
                    <div class="form-group">
                        <label for="AuditorsFilter">@Localizer["Lbl_AuditorsFilter"]</label>
                        <input type="text" id="AuditorsFilter" name="AuditorsFilter" value="@Model.AuditorsFilter" placeholder="@Model.Defaults.DefaultFilters.Auditors" />
                        <p class="hint">@Localizer["Hint_AuditorsFilter"]</p>
                    </div>
                    <div class="form-group">
                        <label for="PowerUsersFilter">@Localizer["Lbl_PowerUsersFilter"]</label>
                        <input type="text" id="PowerUsersFilter" name="PowerUsersFilter" value="@Model.PowerUsersFilter" placeholder="@Model.Defaults.DefaultFilters.PowerUsers" />
                        <p class="hint">@Localizer["Hint_PowerUsersFilter"]</p>
                    </div>
                </div>
                <div class="setup-card">
                    <h2>@Localizer["KpiConfig"]</h2>
                    <p class="subtitle">@Localizer["KpiSubtitle"]</p>
                    <div class="form-group">
                        <label for="CustomActiveRolesAdminsBaseDn">@Localizer["Lbl_ArAdminsBaseDn"]</label>
                        <input type="text" id="CustomActiveRolesAdminsBaseDn" name="CustomActiveRolesAdminsBaseDn" value="@Model.CustomActiveRolesAdminsBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
                    </div>
                    <div class="form-group">
                        <label for="CustomActiveRolesAdminsFilter">@Localizer["Lbl_ArAdminsFilter"]</label>
                        <input type="text" id="CustomActiveRolesAdminsFilter" name="CustomActiveRolesAdminsFilter" value="@Model.CustomActiveRolesAdminsFilter" placeholder="@Model.Defaults.DefaultFilters.ActiveRolesAdmins" />
                    </div>
                    <div class="form-group">
                        <label for="CustomNoGroupOwnerBaseDn">@Localizer["Lbl_NoGroupOwnerBaseDn"]</label>
                        <input type="text" id="CustomNoGroupOwnerBaseDn" name="CustomNoGroupOwnerBaseDn" value="@Model.CustomNoGroupOwnerBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
                    </div>
                    <div class="form-group">
                        <label for="CustomNoManagerUserBaseDn">@Localizer["Lbl_NoManagerUserBaseDn"]</label>
                        <input type="text" id="CustomNoManagerUserBaseDn" name="CustomNoManagerUserBaseDn" value="@Model.CustomNoManagerUserBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
                    </div>
                    <div class="form-group">
                        <label for="CustomNoManagerUserFilter">@Localizer["Lbl_NoManagerUserFilter"]</label>
                        <input type="text" id="CustomNoManagerUserFilter" name="CustomNoManagerUserFilter" value="@Model.CustomNoManagerUserFilter" placeholder="@Model.Defaults.DefaultFilters.NoManagerUser" />
                    </div>
                    <div class="form-group">
                        <label for="CustomNoManagerServiceAccountBaseDn">@Localizer["Lbl_NoManagerSaBaseDn"]</label>
                        <input type="text" id="CustomNoManagerServiceAccountBaseDn" name="CustomNoManagerServiceAccountBaseDn" value="@Model.CustomNoManagerServiceAccountBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
                    </div>
                    <div class="form-group">
                        <label for="CustomNoManagerServiceAccountFilter">@Localizer["Lbl_NoManagerSaFilter"]</label>
                        <input type="text" id="CustomNoManagerServiceAccountFilter" name="CustomNoManagerServiceAccountFilter" value="@Model.CustomNoManagerServiceAccountFilter" placeholder="@Model.Defaults.DefaultFilters.NoManagerServiceAccount" />
                    </div>
                    <div class="form-group">
                        <label for="CustomUserAccountExpiredBaseDn">@Localizer["Lbl_UserExpiredBaseDn"]</label>
                        <input type="text" id="CustomUserAccountExpiredBaseDn" name="CustomUserAccountExpiredBaseDn" value="@Model.CustomUserAccountExpiredBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
                    </div>
                    <div class="form-group">
                        <label for="CustomUserAccountLockedOutBaseDn">@Localizer["Lbl_UserLockedBaseDn"]</label>
                        <input type="text" id="CustomUserAccountLockedOutBaseDn" name="CustomUserAccountLockedOutBaseDn" value="@Model.CustomUserAccountLockedOutBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
                    </div>
                    <div class="form-group">
                        <label for="CustomEmptyGroupsBaseDn">@Localizer["Lbl_EmptyGroupsBaseDn"]</label>
                        <input type="text" id="CustomEmptyGroupsBaseDn" name="CustomEmptyGroupsBaseDn" value="@Model.CustomEmptyGroupsBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
                    </div>
                </div>
                <div class="wizard-nav">
                    <button type="button" class="btn-back" onclick="wizardBack()">@Localizer["Back"]</button>
                    <button type="button" class="btn-next" onclick="wizardNext()">@Localizer["Next"]</button>
                </div>
            </div>

            <!-- Page 6: Licensing Thresholds -->
            <div class="wizard-page" data-page="5">
                <div class="setup-card">
                    <h2>@Localizer["LicensingThresholds"]</h2>
                    <p class="subtitle">@Localizer["LicensingThresholdsSubtitle"]</p>
                    <div class="form-group">
                        <label for="LicensedDomainObjects">@Localizer["Lbl_LicensedDomainObjects"]</label>
                        <input type="text" inputmode="numeric" id="LicensedDomainObjects" name="LicensedDomainObjects" value="@Model.LicensedDomainObjects" placeholder="0" />
                    </div>
                    <div class="form-group">
                        <label for="LicensedPartitionObjects">@Localizer["Lbl_LicensedPartitionObjects"]</label>
                        <input type="text" inputmode="numeric" id="LicensedPartitionObjects" name="LicensedPartitionObjects" value="@Model.LicensedPartitionObjects" placeholder="0" />
                    </div>
                    <div class="form-group">
                        <label for="LicensedAzureObjects">@Localizer["Lbl_LicensedAzureObjects"]</label>
                        <input type="text" inputmode="numeric" id="LicensedAzureObjects" name="LicensedAzureObjects" value="@Model.LicensedAzureObjects" placeholder="0" />
                    </div>
                    <div class="form-group">
                        <label for="LicensedSaasObjects">@Localizer["Lbl_LicensedSaasObjects"]</label>
                        <input type="text" inputmode="numeric" id="LicensedSaasObjects" name="LicensedSaasObjects" value="@Model.LicensedSaasObjects" placeholder="0" />
                    </div>
                    <div class="form-group">
                        <label for="LicensedTotalObjects">@Localizer["Lbl_LicensedTotalObjects"]</label>
                        <input type="text" inputmode="numeric" id="LicensedTotalObjects" name="LicensedTotalObjects" value="@Model.LicensedTotalObjects" placeholder="0" />
                        <p class="hint">@Localizer["LicensedThresholdsHint"]</p>
                    </div>
                </div>
                <div class="wizard-nav">
                    <button type="button" class="btn-back" onclick="wizardBack()">@Localizer["Back"]</button>
                    <button type="submit" class="btn-finish">@Localizer["FinishSetup"]</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    var setupI18n = {
        apiUrlRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Err_ApiUrlRequired"].Value)),
        rstsUrlRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Err_RstsUrlRequired"].Value)),
        saUsernameRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Err_SaUsernameRequired"].Value)),
        saPasswordRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Err_SaPasswordRequired"].Value))
    };
    (function () {
        var currentPage = 0;
        var totalPages = 6;

        function showPage(index) {
            var pages = document.querySelectorAll('.wizard-page');
            var steps = document.querySelectorAll('.wizard-steps .step');
            pages.forEach(function (p, i) {
                p.classList.toggle('active', i === index);
            });
            steps.forEach(function (s, i) {
                s.classList.remove('active', 'completed');
                if (i < index) s.classList.add('completed');
                else if (i === index) s.classList.add('active');
            });
            currentPage = index;
            hideError();
        }

        function hideError() {
            document.getElementById('wizardError').style.display = 'none';
        }

        function showError(msg) {
            var el = document.getElementById('wizardError');
            el.textContent = msg;
            el.style.display = 'block';
        }

        function validatePage(index) {
            if (document.getElementById('DemoMode').checked) return true;
            if (index === 0) {
                var apiUrl = document.getElementById('ApiBaseUrl').value.trim();
                var rstsUrl = document.getElementById('RstsUrl').value.trim();
                if (!apiUrl) { showError(setupI18n.apiUrlRequired); document.getElementById('ApiBaseUrl').focus(); return false; }
                if (!rstsUrl) { showError(setupI18n.rstsUrlRequired); document.getElementById('RstsUrl').focus(); return false; }
            }
            if (index === 1) {
                var saUser = document.getElementById('ServiceAccountUsername').value.trim();
                var saPass = document.getElementById('ServiceAccountPassword').value;
                if (!saUser) { showError(setupI18n.saUsernameRequired); document.getElementById('ServiceAccountUsername').focus(); return false; }
                if (!saPass) { showError(setupI18n.saPasswordRequired); document.getElementById('ServiceAccountPassword').focus(); return false; }
            }
            return true;
        }

        window.wizardNext = function () {
            if (!validatePage(currentPage)) return;
            if (currentPage === 0 && document.getElementById('DemoMode').checked) {
                showPage(totalPages - 1);
                return;
            }
            if (currentPage < totalPages - 1) {
                showPage(currentPage + 1);
            }
        };

        window.wizardBack = function () {
            if (currentPage > 0) {
                showPage(currentPage - 1);
            }
        };

        window.updateLangFlag = function (select) {
            var opt = select.options[select.selectedIndex];
            var flag = opt.getAttribute('data-flag');
            if (flag) document.getElementById('langFlag').src = flag;
        };
    })();
</script>
</body>
</html>
