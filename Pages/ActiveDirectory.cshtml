@page
@model ActiveRolesDashboard.Pages.ActiveDirectoryModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Active Directory";
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <base href="@Url.Content("~/")" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Active Roles Dashboard - Active Directory</title>
    <link rel="stylesheet" href="css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/ad-dashboard.css" asp-append-version="true" />
</head>
<body class="ad-dashboard-design">
<div class="loading-overlay active" id="loadingOverlay">
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p>@Localizer["LoadingDashboardData"]</p>
    </div>
</div>
@await Html.PartialAsync("_AdDashboardFrame", Model)
</body>
</html>